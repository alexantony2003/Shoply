<% const wishlist = [
  { id: 3, name: 'Everyday Sneakers', category: 'Footwear', price: 64.50, availability: 'In stock' },
  { id: 4, name: 'Ceramic Desk Lamp', category: 'Home', price: 42.00, availability: 'In stock' },
  { id: 5, name: 'Cotton Overshirt', category: 'Clothing', price: 55.00, availability: 'Coming soon' }
]; %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Shoply | Wishlist</title><style>body{margin:0;font-family:Arial,sans-serif;background:#f7f8fa;color:#20252b}.content{max-width:1000px;margin:34px auto;padding:0 20px}.products{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}.product{padding:20px;background:#fff;border:1px solid #e5e7eb;border-radius:8px}.image{height:140px;display:grid;place-items:center;background:#eef2ff;border-radius:6px;color:#64748b}.button{display:inline-block;padding:10px 14px;background:#2563eb;color:#fff;border-radius:6px;text-decoration:none}.remove{margin-left:12px;color:#b42318}</style></head><body><main class="content"><h1>My wishlist</h1><p>Products saved for later.</p><section class="products"><% wishlist.forEach(item => { %><article class="product"><div class="image">Product image</div><h2><%= item.name %></h2><p><%= item.category %> | <%= item.availability %></p><p><strong>$<%= item.price.toFixed(2) %></strong></p><% if (item.availability === 'In stock') { %><a class="button" href="/cart?add=<%= item.id %>">Add to cart</a><% } %><a class="remove" href="/wishlist/remove/<%= item.id %>">Remove</a></article><% }); %></section></main></body></html>

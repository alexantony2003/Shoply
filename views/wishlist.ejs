<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Shoply | Wishlist</title><link rel="stylesheet" href="/styles.css">
</head>
<body><main class="content" style="max-width:1100px;margin:36px auto;padding:0 20px">
  <p><a href="/products">Continue shopping</a></p><h1>My wishlist</h1><p>Products saved for later.</p>
  <% if (!products.length) { %><section class="panel"><p>Your wishlist is empty.</p><a class="button" href="/products">Browse products</a></section><% } else { %>
    <section class="products"><% products.forEach(product => { %>
      <%
        const isCategoryUnlisted = !product.category || product.category.status === false;
        const isUnavailable = product.status !== 'active' || isCategoryUnlisted;
      %>
      <article class="product <%= isUnavailable ? 'unavailable-product' : '' %>">
      <% if (product.image) { %>
        <div style="position:relative">
          <% if (isUnavailable) { %><span class="unavailable-badge">Unavailable</span><% } %>
          <img class="image" src="<%= product.image %>" alt="<%= product.name %>">
        </div>
      <% } %>
      <h2><a href="/products/<%= product._id %>"><%= product.name %></a></h2>
      <p><%= product.category ? product.category.name : 'Uncategorised' %></p>
      <% if (isUnavailable) { %><p class="unavailable-label" role="status">Unavailable</p><% } %>
      <p class="price">₹<%= Number(product.price).toFixed(2) %></p>
      <form action="/wishlist/<%= product._id %>/remove" method="post"><button class="secondary" type="submit">Remove</button></form>
    </article><% }); %></section>
  <% } %>
</main></body></html>

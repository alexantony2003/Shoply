<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Shoply | Home</title>

  <link rel="stylesheet" href="/styles.css">
  <script>(function(){try{var t=localStorage.getItem('shoply-theme');if(!t){t=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
  <script defer src="/app.js"></script>

</head>

<body data-user-role="<%= typeof user !== 'undefined' && user && user.role ? user.role : 'customer' %>">

  <header class="site-header glass-card">

    <a class="brand" href="/">
      Shoply
    </a>

    <nav class="glass-card" aria-label="Main navigation">

      <a href="/">Home</a>
      <a href="/products">Shop</a>
      <a href="/cart">Cart</a>
      <a href="/wishlist">Wishlist</a>

      <% if (typeof user !== 'undefined' && user) { 
          const nameParts = (user.name || 'Account').trim().split(/\s+/).filter(Boolean);
          const userInitials = nameParts.length > 1
            ? (nameParts[0][0] + nameParts[nameParts.length - 1][0]).toUpperCase()
            : (nameParts[0] ? nameParts[0].slice(0, 2).toUpperCase() : 'AA');
          const userFirstName = nameParts[0] || 'Account';
      %>
        <!-- Account Dropdown -->
        <div class="profile-container">
          <button
            id="account-menu-button"
            type="button"
            class="profile-link"
            onclick="toggleProfileMenu(event)"
            aria-label="Account menu"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="profileMenu"
            title="Account (<%= user.name %>)"
          >
            <span class="profile-avatar" aria-hidden="true"><%= userInitials %></span>
            <span class="profile-name"><%= userFirstName %></span>
            <svg class="profile-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <!-- Floating Account Menu Card -->
          <div class="profile-menu" id="profileMenu" role="menu" aria-labelledby="account-menu-button">
            <div class="profile-menu-header">
              <div class="profile-menu-avatar" aria-hidden="true"><%= userInitials %></div>
              <div class="profile-menu-info">
                <strong class="profile-menu-name"><%= user.name %></strong>
                <span class="profile-menu-email"><%= user.email %></span>
                <% if (user.role === 'admin') { %>
                  <span class="profile-menu-badge">Administrator</span>
                <% } %>
              </div>
            </div>

            <div class="profile-menu-divider" role="separator"></div>

            <div class="profile-menu-links">
              <a href="/profile" class="profile-menu-item" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                <span>My profile</span>
              </a>

              <% if (user.role === 'admin') { %>
                <a href="/admin" class="profile-menu-item" role="menuitem">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                  <span>Admin dashboard</span>
                </a>
              <% } %>

              <a href="/orders" class="profile-menu-item" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                <span>My orders</span>
              </a>

              <a href="/wishlist" class="profile-menu-item" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                <span>Wishlist</span>
              </a>
            </div>

            <div class="profile-menu-divider" role="separator"></div>

            <a href="/logout" class="profile-menu-item profile-menu-logout" role="menuitem">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
              <span>Sign out</span>
            </a>
          </div>
        </div>
      <% } else { %>
        <a href="/login">Sign in</a>
      <% } %>

    </nav>

  </header>

  <%- include('partials/category-nav') %>

  <section class="hero">

    <h1>
      Useful things, thoughtfully chosen.
    </h1>

    <p>
      Discover everyday products selected for comfort, quality, and style.
    </p>

    <form
      class="home-search"
      action="/products"
      method="get"
    >

      <input
        name="search"
        type="search"
        placeholder="Search products by name or category"
        aria-label="Search products"
      >

      <button
        class="button"
        type="submit"
      >
        Find products
      </button>

    </form>

  </section>


  <main class="content" id="products">

    <h2>
      Featured products
    </h2>

    <div class="products">

      <% products.forEach(product => { %>
          <%
            const isCategoryUnlisted = !product.category || product.category.status === false;
            const isUnavailable = product.status !== 'active' || isCategoryUnlisted;
          %>
        <article class="product <%= isUnavailable ? 'unavailable-product' : '' %>">

          <% const cardImages = product.variants && product.variants.length && product.variants[0].images && product.variants[0].images.length
            ? product.variants[0].images
            : (product.images && product.images.length ? product.images : (product.image ? [product.image] : [])); %>
          <% if (cardImages.length) { %>

            <a class="product-image-frame" data-parallax-area data-swipe-gallery data-image-list="<%= JSON.stringify(cardImages) %>" href="/products/<%= product._id %>">
              <% if (isUnavailable) { %><span class="unavailable-badge">Unavailable</span><% } else if (product.showNewTag && product.status === 'active') { %><span class="newly-added-badge">Newly added</span><% } %>
              <img
                class="image"
                data-parallax-image
                data-gallery-image
                src="<%= cardImages[0] %>"
                alt="<%= product.name %>"
              >
            </a>

          <% } else { %>

            <div class="image">
              Product image
            </div>

          <% } %>

          <h3>
            <%= product.name %>
          </h3>
          <% if (isUnavailable) { %>
            <p class="unavailable-label" role="status">Unavailable</p>
          <% } %>

          <p class="rating">
            ★ <%= Number(product.rating || 0).toFixed(1) %> / 5
            (<%= product.reviews ? product.reviews.length : 0 %> reviews)
          </p>
          <p class="availability"><%= product.stock <= 5 ? `Only ${product.stock} left in stock` : `${product.stock} in stock` %></p>

          <%
            const homeSalePrice = Number(
              product.variants && product.variants[0] && product.variants[0].options && product.variants[0].options[0]
                ? product.variants[0].options[0].price
                : product.price
            ) || 0;
            const homeOriginalPrice = Number(product.originalPrice) > homeSalePrice
              ? Number(product.originalPrice)
              : (Number(product.discountPercentage) > 0 && Number(product.discountPercentage) < 100
                ? homeSalePrice / (1 - Number(product.discountPercentage) / 100)
                : null);
            const homeDiscount = homeOriginalPrice
              ? Math.round((homeOriginalPrice - homeSalePrice) / homeOriginalPrice * 100)
              : 0;
          %>
          <p class="price">
            <% if (homeOriginalPrice && homeDiscount > 0) { %>
              <span class="discount">&darr;<%= homeDiscount %>%</span>
              <span class="original-price">$<%= homeOriginalPrice.toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) %></span>
            <% } %>
            <span>$<%= homeSalePrice.toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) %></span>
          </p>

          <a
            class="button"
            href="/products/<%= product._id %>"
          >
            View product
          </a>

        </article>

      <% }); %>

    </div>

  </main>


  <script>
    function toggleProfileMenu(event) {
      if (event) {
        event.preventDefault();
        event.stopPropagation();
      }
      const menu = document.getElementById("profileMenu");
      const btn = document.getElementById("account-menu-button");
      if (!menu) return;
      const isOpen = menu.classList.toggle("show");
      if (btn) {
        btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      }
    }

    // Close menu when clicking outside or pressing Escape
    document.addEventListener("click", function(event) {
      const profileContainer = document.querySelector(".profile-container");
      const menu = document.getElementById("profileMenu");
      if (profileContainer && menu && !profileContainer.contains(event.target)) {
        menu.classList.remove("show");
        const btn = document.getElementById('account-menu-button');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') {
        const menu = document.getElementById('profileMenu');
        if (menu && menu.classList.contains('show')) {
          menu.classList.remove('show');
          const btn = document.getElementById('account-menu-button');
          if (btn) {
            btn.setAttribute('aria-expanded', 'false');
            btn.focus();
          }
        }
      }
    });
  </script>

</body>

</html>

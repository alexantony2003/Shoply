<% const cartItems = [
  { id: 1, name: 'Minimal Leather Backpack', price: 79.99, quantity: 1 },
  { id: 2, name: 'Wireless Headphones', price: 129.00, quantity: 1 }
]; const subtotal = cartItems.reduce((total, item) => total + item.price * item.quantity, 0); const shipping = 8.00; %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Shoply | Cart</title>
<style>body{margin:0;font-family:Arial,sans-serif;background:#f7f8fa;color:#20252b}header{padding:18px 6%;background:#fff;border-bottom:1px solid #e5e7eb}header a{color:#2563eb;text-decoration:none;font-size:24px;font-weight:bold}.content{max-width:980px;margin:34px auto;padding:0 20px}.layout{display:grid;grid-template-columns:1fr 300px;gap:24px}.items,.summary{background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:22px}.item{display:flex;justify-content:space-between;gap:20px;padding:18px 0;border-bottom:1px solid #e5e7eb}.item:last-child{border:0}.price{font-weight:bold}.summary p{display:flex;justify-content:space-between}.total{font-size:20px;font-weight:bold}.button{display:block;padding:12px;text-align:center;background:#2563eb;color:#fff;text-decoration:none;border-radius:6px}@media(max-width:700px){.layout{grid-template-columns:1fr}}</style><link rel="stylesheet" href="/styles.css"><script defer src="/app.js"></script></head>
<body><header><a href="/">Shoply</a></header><main class="content"><h1>Your cart</h1><div class="layout"><section class="items"><% cartItems.forEach(item => { %><article class="item"><div><h3><%= item.name %></h3><p>Quantity: <%= item.quantity %></p><a href="/cart/remove/<%= item.id %>">Remove</a></div><p class="price">$<%= (item.price * item.quantity).toFixed(2) %></p></article><% }); %></section><aside class="summary"><h2>Order summary</h2><p><span>Subtotal</span><span>$<%= subtotal.toFixed(2) %></span></p><p><span>Shipping</span><span>$<%= shipping.toFixed(2) %></span></p><p class="total"><span>Total</span><span>$<%= (subtotal + shipping).toFixed(2) %></span></p><a class="button" href="/checkout">Proceed to checkout</a></aside></div></main></body></html>

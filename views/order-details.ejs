<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Shoply | <%= order.orderNumber %></title><link rel="stylesheet" href="/styles.css"></head>
<body><main class="page-shell order-detail-page">
  <a class="page-back-link" href="/orders">← Back to orders</a>
  <header class="page-title-row"><div><p class="page-eyebrow">ORDER DETAILS</p><h1><%= order.orderNumber %></h1></div><span class="order-status order-status-<%= order.status.toLowerCase().replace(/\s+/g, '-') %>"><%= order.status %></span></header>
  <% if (paymentError) { %><p class="account-alert account-alert-error" role="alert">Your online payment is still pending. Please try again when Razorpay is available.</p><% } %>
  <section class="panel order-summary-card">
    <div class="order-meta"><div><span>Placed</span><strong><%= new Date(order.createdAt).toLocaleString() %></strong></div><div><span>Payment</span><strong><%= order.paymentMethod %></strong></div><div><span>Payment status</span><strong><%= order.paymentStatus %></strong></div></div>
    <div class="order-card-divider"></div><h2>Items</h2>
    <div class="order-items-list"><% order.items.forEach(item => { %><article class="order-line-item"><div><h3><%= item.name %></h3><p><%= [item.color, item.variant].filter(Boolean).join(' · ') || 'Standard option' %> · Quantity <%= item.quantity %></p></div><strong>₹<%= (item.unitPrice * item.quantity).toFixed(2) %></strong></article><% }); %></div>
    <div class="order-totals"><p><span>Subtotal</span><strong>₹<%= Number(order.subtotal).toFixed(2) %></strong></p><% if (order.discountAmount) { %><p><span>Coupon <%= order.couponCode %></span><strong>-₹<%= Number(order.discountAmount).toFixed(2) %></strong></p><% } %><% if (order.deliveryCharge) { %><p><span>Delivery</span><strong>₹<%= Number(order.deliveryCharge).toFixed(2) %></strong></p><% } %><p class="order-total"><span>Total</span><strong>₹<%= Number(order.total).toFixed(2) %></strong></p></div>
  </section>
  <section class="panel order-address-card"><p class="page-eyebrow">DELIVERY ADDRESS</p><h2><%= order.shippingAddress.fullName %></h2><p><%= order.shippingAddress.street %><br><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.postalCode %><br><%= order.shippingAddress.country %></p><a href="tel:<%= order.shippingAddress.phone %>"><%= order.shippingAddress.phone %></a></section>
  <% if (order.status === 'Pending') { %><form class="order-actions" action="/orders/<%= order._id %>/cancel" method="post" onsubmit="return confirm('Cancel this order?')"><button type="submit">Cancel order</button></form><% } %>
  <% if (order.status === 'Delivered') { %><form class="order-actions" action="/orders/<%= order._id %>/return" method="post" onsubmit="return confirm('Request a return for this order?')"><button type="submit">Request return</button></form><% } %>
  <div class="order-actions"><a class="button secondary" href="/orders/<%= order._id %>/invoice">Download invoice (PDF)</a><% if (order.paymentMethod === 'Razorpay' && order.paymentStatus !== 'Paid') { %><form action="/orders/<%= order._id %>/pay" method="post"><button type="submit">Continue payment</button></form><% } %></div>
</main></body></html>

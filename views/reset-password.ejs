<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Shoply | Set new password</title><link rel="stylesheet" href="/styles.css"></head>
<body><main class="panel" style="max-width:440px;margin:8vh auto;padding:32px">
  <h1>Set a new password</h1>
  <p>A six-digit reset code is valid for five minutes.</p>
  <% if (error) { %><p role="alert"><%= error %></p><% } %>
  <form action="/reset-password" method="post">
    <label for="code">Reset code</label><input id="code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required>
    <label for="password">New password</label><input id="password" name="password" type="password" minlength="8" autocomplete="new-password" required>
    <label for="confirmPassword">Confirm new password</label><input id="confirmPassword" name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required>
    <button class="button" type="submit">Update password</button>
  </form>
  <p><a href="/forgot-password">Request a new code</a> · <a href="/login">Back to login</a></p>
</main></body></html>

<% const orders = [{ id: 'SHP-1048', date: 'September 18, 2026', total: 208.99, status: 'Delivered' }, { id: 'SHP-1029', date: 'September 04, 2026', total: 64.50, status: 'Shipped' }, { id: 'SHP-1007', date: 'August 22, 2026', total: 42.00, status: 'Delivered' }]; %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Shoply | Orders</title><style>body{margin:0;font-family:Arial,sans-serif;background:#f7f8fa;color:#20252b}.content{max-width:900px;margin:34px auto;padding:0 20px}.table{width:100%;border-collapse:collapse;background:#fff;border:1px solid #e5e7eb}.table th,.table td{padding:16px;text-align:left;border-bottom:1px solid #e5e7eb}.status{color:#067647;font-weight:bold}.link{color:#2563eb}@media(max-width:650px){.table th:nth-child(2),.table td:nth-child(2){display:none}}</style></head><body><main class="content"><h1>Order history</h1><table class="table"><thead><tr><th>Order</th><th>Date</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody><% orders.forEach(order => { %><tr><td><%= order.id %></td><td><%= order.date %></td><td>$<%= order.total.toFixed(2) %></td><td class="status"><%= order.status %></td><td><a class="link" href="/orders/<%= order.id %>">View</a></td></tr><% }); %></tbody></table></main></body></html>

<% const user = { name: 'Alex Antony', email: 'alex@example.com', phone: '+1 555 010 2026' }; %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Shoply | Edit profile</title><style>body{margin:0;font-family:Arial,sans-serif;background:#f7f8fa;color:#20252b}.panel{max-width:620px;margin:34px auto;padding:26px;background:#fff;border:1px solid #e5e7eb;border-radius:8px}label{display:block;margin:16px 0 6px;font-weight:bold}input{box-sizing:border-box;width:100%;padding:11px;border:1px solid #d5dbe3;border-radius:6px}button{margin-top:22px;padding:12px 18px;border:0;border-radius:6px;background:#2563eb;color:#fff;font-weight:bold}a{color:#2563eb}</style></head><body><main class="panel"><p><a href="/profile">Back to profile</a></p><h1>Edit profile</h1><form action="/profile/edit" method="post"><label for="name">Full name</label><input id="name" name="name" type="text" value="<%= user.name %>" required><label for="email">Email address</label><input id="email" name="email" type="email" value="<%= user.email %>" required><label for="phone">Phone</label><input id="phone" name="phone" type="tel" value="<%= user.phone %>"><label for="address">Default address</label><input id="address" name="address" type="text" value="123 Market Street, New York, NY 10001"><button type="submit">Save changes</button></form></main></body></html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My account | Shoply</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="account-page" data-user-role="<%= user && user.role ? user.role : 'customer' %>">
  <header class="account-header site-header glass-card">
    <a class="brand account-brand" href="/">Shoply</a>
    <nav class="glass-card" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/products">Shop</a>
      <a href="/cart">Cart</a>
      <a href="/wishlist">Wishlist</a>
      <a href="/profile" aria-current="page">Account</a>
      <% if (user && user.role === 'admin') { %>
        <a class="admin-dashboard-link" href="/admin">Admin</a>
      <% } %>
      <button type="button" class="theme-toggle-btn store-theme-toggle" aria-label="Toggle light or dark theme">
        <span class="theme-toggle-icon" aria-hidden="true"></span>
        <span class="theme-text">Theme</span>
      </button>
    </nav>
  </header>

  <%- include('partials/category-nav') %>

  <main class="account-shell">
    <div class="account-heading">
      <div>
        <p class="account-eyebrow"><%= user.role === 'admin' ? 'ADMINISTRATOR CONSOLE' : 'YOUR SHOPLY ACCOUNT' %></p>
        <h1>My profile</h1>
        <p><%= user.role === 'admin' ? 'Manage your administrator identity, security credentials, and store management shortcuts.' : 'Manage your personal details, delivery addresses, and orders.' %></p>
      </div>
      <div class="account-heading-actions">
        <% if (user.role === 'admin') { %>
          <a class="account-button account-button-light" href="/admin/profile">Admin Profile</a>
          <a class="account-button account-button-light" href="/admin">Dashboard</a>
        <% } %>
        <a class="account-button" href="/profile/edit">Edit profile</a>
      </div>
    </div>

    <% if (user.role === 'admin') { %>
      <div class="account-card glass-card admin-callout-card">
        <div class="admin-callout-content">
          <span class="admin-role-badge">VERIFIED SYSTEM ADMINISTRATOR</span>
          <h2>You are viewing your account with Administrator Privileges</h2>
          <p>You have full store-wide administrative rights. Access management dashboards to manage product catalog, track customer orders, analyze real-time sales reports, and configure store settings.</p>
        </div>
        <div class="admin-callout-actions">
          <a class="account-button" href="/admin/profile">Admin Profile &amp; Security &rarr;</a>
          <a class="account-button account-button-light" href="/admin">Go to Console</a>
        </div>
      </div>
    <% } %>

    <% if (typeof updated !== 'undefined' && updated) { %>
      <div class="account-alert account-alert-success" role="status">Your profile was updated successfully.</div>
    <% } %>

    <div class="account-grid">
      <!-- 1. Personal Details Card -->
      <section class="account-card account-personal-card" aria-labelledby="personal-details-title">
        <div>
          <div class="account-card-heading">
            <div class="account-avatar" aria-hidden="true"><%= user.name ? user.name.split(' ').map(name => name[0]).join('').slice(0, 2).toUpperCase() : 'US' %></div>
            <div>
              <p class="account-eyebrow">PERSONAL DETAILS</p>
              <h2 id="personal-details-title"><%= user.name %></h2>
            </div>
          </div>
          <dl class="account-details">
            <div><dt>Email address</dt><dd><%= user.email %></dd></div>
            <div><dt>Phone number</dt><dd><%= user.phone || "Not provided" %></dd></div>
            <div>
              <dt>Account Role</dt>
              <dd>
                <% if (user.role === 'admin') { %>
                  <span class="admin-role-badge" style="display:inline-block; font-size:11px; padding: 2px 8px;">System Administrator</span>
                <% } else { %>
                  Customer
                <% } %>
              </dd>
            </div>
            <div><dt>Member since</dt><dd><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : "—" %></dd></div>
          </dl>
        </div>
        <a class="account-text-link" href="/profile/edit">Update personal details <span aria-hidden="true">&rarr;</span></a>
      </section>

      <!-- 2. Admin Tools Card (Admin) OR Your Orders (Customer) -->
      <% if (user.role === 'admin') { %>
        <section class="account-card account-admin-tools-card" aria-labelledby="admin-tools-title">
          <div>
            <div class="account-section-heading">
              <div>
                <p class="account-eyebrow">CONSOLE QUICK ACCESS</p>
                <h2 id="admin-tools-title">Administrative Tools</h2>
              </div>
            </div>
            <div class="admin-tools-grid">
              <a class="admin-tool-item" href="/admin">
                <span class="admin-tool-icon">📊</span>
                <span>Dashboard</span>
              </a>
              <a class="admin-tool-item" href="/admin/products">
                <span class="admin-tool-icon">📦</span>
                <span>Products</span>
              </a>
              <a class="admin-tool-item" href="/admin/orders">
                <span class="admin-tool-icon">🛍️</span>
                <span>Orders</span>
              </a>
              <a class="admin-tool-item" href="/admin/categories">
                <span class="admin-tool-icon">🏷️</span>
                <span>Categories</span>
              </a>
              <a class="admin-tool-item" href="/admin/sales-report">
                <span class="admin-tool-icon">📈</span>
                <span>Sales Report</span>
              </a>
              <a class="admin-tool-item" href="/admin/users">
                <span class="admin-tool-icon">👥</span>
                <span>Users</span>
              </a>
            </div>
          </div>
          <a class="account-button account-button-light" style="width: 100%; box-sizing: border-box; text-align: center; justify-content: center; margin-top: auto;" href="/admin">Open Admin Console &rarr;</a>
        </section>
      <% } else { %>
        <section class="account-card account-orders-card" aria-labelledby="orders-title">
          <div>
            <p class="account-eyebrow">SHOPPING</p>
            <h2 id="orders-title">Your orders</h2>
            <p class="account-stat"><strong><%= orderCount %></strong> <span><%= orderCount === 1 ? "order placed" : "orders placed" %></span></p>
          </div>
          <a class="account-button account-button-light" href="/orders">View order history</a>
        </section>
      <% } %>

      <!-- 3. Storefront Activity (Admin) OR Saved Addresses (Customer) -->
      <% if (user.role === 'admin') { %>
        <section class="account-card account-orders-card" aria-labelledby="storefront-activity-title">
          <div>
            <p class="account-eyebrow">STOREFRONT ORDERS &amp; ADDRESSES</p>
            <h2 id="storefront-activity-title">Storefront Activity</h2>
            <p class="account-stat"><strong><%= orderCount %></strong> <span><%= orderCount === 1 ? "store order placed" : "store orders placed" %></span></p>
            <p style="font-size: 13.5px; color: var(--muted); margin: -10px 0 18px; line-height: 1.45;">
              <%= addresses.length %> saved delivery <%= addresses.length === 1 ? 'address' : 'addresses' %> associated with this admin account.
            </p>
          </div>
          <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: auto;">
            <a class="account-button account-button-light" href="/orders">View Orders</a>
            <a class="account-button account-button-light" href="/profile/addresses/new">Add Address</a>
          </div>
        </section>
      <% } else { %>
        <section class="account-card account-addresses-card" aria-labelledby="addresses-title">
          <div>
            <div class="account-section-heading">
              <div>
                <p class="account-eyebrow">DELIVERY</p>
                <h2 id="addresses-title">Saved addresses</h2>
              </div>
              <a class="account-button account-button-light" href="/profile/addresses/new">Add address</a>
            </div>
            <% if (!addresses.length) { %>
              <div class="account-empty">
                <span class="account-empty-icon" aria-hidden="true">⌂</span>
                <h3>No saved addresses yet</h3>
                <p>Add an address for faster checkout next time.</p>
                <a class="account-text-link" href="/profile/addresses/new">Add your first address <span aria-hidden="true">&rarr;</span></a>
              </div>
            <% } else { %>
              <div class="account-address-list">
                <% addresses.forEach(address => { %>
                  <article class="account-address">
                    <div class="account-address-topline">
                      <h3><%= address.label %></h3>
                      <% if (address.isDefault) { %><span class="account-default-badge">DEFAULT</span><% } %>
                    </div>
                    <p class="account-address-name"><%= address.fullName %> <span>·</span> <%= address.phone %></p>
                    <p class="account-address-copy"><%= address.street %><br><%= address.city %>, <%= address.state %> <%= address.postalCode %><br><%= address.country %></p>
                    <div class="account-address-actions">
                      <a href="/profile/addresses/<%= address._id %>/edit">Edit address</a>
                      <form action="/profile/addresses/<%= address._id %>/delete" method="post" onsubmit="return confirm('Delete this address?')">
                        <button class="account-inline-button" type="submit">Delete</button>
                      </form>
                    </div>
                  </article>
                <% }); %>
              </div>
            <% } %>
          </div>
        </section>
      <% } %>

      <!-- 4. Account Security Card -->
      <section class="account-card account-security-card" aria-labelledby="security-title">
        <div>
          <p class="account-eyebrow">ACCOUNT SECURITY</p>
          <h2 id="security-title">Password &amp; Credentials</h2>
          <p style="color: var(--muted); font-size: 14px; margin: 10px 0 16px; line-height: 1.5;">
            <% if (user.role === 'admin') { %>
              Manage your administrator console password securely, or request a storefront reset email.
            <% } else { %>
              Keep your account secure by choosing a strong password.
            <% } %>
          </p>
        </div>
        <% if (user.role === 'admin') { %>
          <div style="display: flex; flex-direction: column; gap: 10px; margin-top: auto;">
            <a class="account-button account-button-light" style="justify-content: center;" href="/admin/profile">Update Admin Password &rarr;</a>
            <a class="account-text-link" href="/forgot-password">Reset via Email <span aria-hidden="true">&rarr;</span></a>
          </div>
        <% } else { %>
          <a class="account-text-link" href="/forgot-password">Reset password <span aria-hidden="true">&rarr;</span></a>
        <% } %>
      </section>
    </div>

    <!-- If Admin and has saved addresses, display addresses manager -->
    <% if (user.role === 'admin' && addresses && addresses.length > 0) { %>
      <section class="account-card glass-card" style="margin-top: 24px;" aria-labelledby="admin-addresses-title">
        <div class="account-section-heading">
          <div>
            <p class="account-eyebrow">DELIVERY ADDRESSES</p>
            <h2 id="admin-addresses-title">Saved Delivery Addresses</h2>
          </div>
          <a class="account-button account-button-light" href="/profile/addresses/new">Add another address</a>
        </div>
        <div class="account-address-list">
          <% addresses.forEach(address => { %>
            <article class="account-address">
              <div class="account-address-topline">
                <h3><%= address.label %></h3>
                <% if (address.isDefault) { %><span class="account-default-badge">DEFAULT</span><% } %>
              </div>
              <p class="account-address-name"><%= address.fullName %> <span>·</span> <%= address.phone %></p>
              <p class="account-address-copy"><%= address.street %><br><%= address.city %>, <%= address.state %> <%= address.postalCode %><br><%= address.country %></p>
              <div class="account-address-actions">
                <a href="/profile/addresses/<%= address._id %>/edit">Edit address</a>
                <form action="/profile/addresses/<%= address._id %>/delete" method="post" onsubmit="return confirm('Delete this address?')">
                  <button class="account-inline-button" type="submit">Delete</button>
                </form>
              </div>
            </article>
          <% }); %>
        </div>
      </section>
    <% } %>

    <form class="account-logout" action="/logout" method="post">
      <button class="account-logout-button" type="submit">Sign out</button>
    </form>
  </main>
</body>
</html>
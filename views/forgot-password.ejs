<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shoply | Reset password</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: var(--color-background);
            color: var(--color-text)
        }

        .panel {
            max-width: 420px;
            margin: 8vh auto;
            padding: 32px;
            background: var(--color-surface);
            border-radius: 12px;
            box-shadow: 0 8px 30px rgb(var(--color-primary-rgb) / 0.12)
        }

        h1 {
            color: var(--color-primary-text)
        }

        label {
            display: block;
            margin: 18px 0 6px;
            font-weight: bold
        }

        input {
            box-sizing: border-box;
            width: 100%;
            padding: 12px;
            border: 1px solid var(--color-border);
            border-radius: 6px
        }

        button {
            width: 100%;
            margin-top: 24px;
            padding: 13px;
            border: 0;
            border-radius: 6px;
            background: var(--color-primary);
            color: var(--color-text-on-solid);
            font-weight: bold
        }

        a {
            color: var(--color-link)
        }

        .muted {
            color: var(--color-text-muted)
        }
    </style>
</head>

<body>
    <main class="panel">
        <h1>Reset your password</h1>
        <p class="muted">Enter your account email to request a one-time password reset code.</p>
        <% if (error) { %><p role="alert"><%= error %></p><% } %>
        <% if (success) { %><p role="status"><%= success %></p><% } %>
        <form action="/forgot-password" method="post"><label for="email">Email address</label><input id="email"
                name="email" type="email" placeholder="alex@example.com" autocomplete="email" required><button type="submit">Send reset code</button></form>
        <p><a href="/reset-password">Enter a reset code</a></p>
        <p><a href="/login">Back to login</a></p>
    </main>
</body>

</html>
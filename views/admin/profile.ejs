<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shoply Admin | My Profile</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <div class="layout">
        <%- include('partials/_sidebar') %>
        <main class="main admin-profile-main">
            <!-- Header -->
            <header class="dash-page-header">
                <div>
                    <span class="dash-eyebrow">ADMIN CONSOLE</span>
                    <h1>My Profile</h1>
                    <p class="dash-subtitle">Manage your administrator details, security credentials, and account settings.</p>
                </div>
                <div class="dash-header-status">
                    <span class="dash-status-dot"></span>
                    <span>Admin Active</span>
                </div>
            </header>

            <!-- Alerts -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success glass-card" role="status" style="margin-bottom: 24px; padding: 14px 20px; border-radius: 12px;">
                    <%= success %>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-error glass-card" role="alert" style="margin-bottom: 24px; padding: 14px 20px; border-radius: 12px;">
                    <%= error %>
                </div>
            <% } %>

            <!-- Profile Content Grid -->
            <div class="admin-profile-grid">
                <!-- Left: Identity Overview -->
                <aside class="admin-profile-sidebar">
                    <section class="panel glass-card admin-identity-card">
                        <div class="admin-avatar-wrap">
                            <div class="admin-avatar-circle" aria-hidden="true">
                                <%= user.name ? user.name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase() : 'AD' %>
                            </div>
                            <h2><%= user.name %></h2>
                            <p class="admin-email-text"><%= user.email %></p>
                            <span class="admin-role-badge">System Administrator</span>
                        </div>

                        <div class="admin-card-divider"></div>

                        <dl class="admin-details-list">
                            <div>
                                <dt>Role</dt>
                                <dd>Super Admin</dd>
                            </div>
                            <div>
                                <dt>Phone</dt>
                                <dd><%= user.phone || 'Not provided' %></dd>
                            </div>
                            <div>
                                <dt>Status</dt>
                                <dd><span class="dash-status-pill status-delivered">Active</span></dd>
                            </div>
                            <div>
                                <dt>Member Since</dt>
                                <dd><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Store Launch' %></dd>
                            </div>
                        </dl>

                        <div class="admin-card-divider"></div>

                        <div class="admin-privileges-box">
                            <h3>Administrative Privileges</h3>
                            <ul class="admin-privilege-list">
                                <li><span>✓</span> Full Product & Inventory Control</li>
                                <li><span>✓</span> Order Processing & Status Updates</li>
                                <li><span>✓</span> Category & Offer Management</li>
                                <li><span>✓</span> Sales Analytics & CSV Reports</li>
                                <li><span>✓</span> User Management & Access Controls</li>
                            </ul>
                        </div>
                    </section>
                </aside>

                <!-- Right: Profile & Password Forms -->
                <div class="admin-profile-forms">
                    <!-- Update Information Form -->
                    <section class="panel glass-card admin-form-card">
                        <div class="dash-card-header">
                            <div>
                                <h2>Personal Information</h2>
                                <p class="dash-card-subtitle">Update your display name, contact phone, and administrator email.</p>
                            </div>
                        </div>

                        <form action="/admin/profile" method="post" class="admin-profile-form">
                            <div class="form-row">
                                <label for="adminName">Full Name</label>
                                <input id="adminName" name="name" type="text" value="<%= user.name || '' %>" maxlength="100" required>
                            </div>

                            <div class="form-row">
                                <label for="adminEmail">Email Address</label>
                                <input id="adminEmail" name="email" type="email" value="<%= user.email || '' %>" maxlength="254" required>
                                <small class="form-hint">Used for admin sign-in and system notifications.</small>
                            </div>

                            <div class="form-row">
                                <label for="adminPhone">Phone Number</label>
                                <input id="adminPhone" name="phone" type="tel" value="<%= user.phone || '' %>" placeholder="+91 98765 43210">
                            </div>

                            <div class="form-actions" style="margin-top: 20px;">
                                <button type="submit" class="button">Save Profile Changes</button>
                            </div>
                        </form>
                    </section>

                    <!-- Change Password Form -->
                    <section class="panel glass-card admin-form-card">
                        <div class="dash-card-header">
                            <div>
                                <h2>Security & Password</h2>
                                <p class="dash-card-subtitle">Ensure your administrator account uses a strong, protected password.</p>
                            </div>
                        </div>

                        <form action="/admin/profile/password" method="post" class="admin-profile-form">
                            <div class="form-row">
                                <label for="currentPassword">Current Password</label>
                                <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required>
                            </div>

                            <div class="form-row">
                                <label for="newPassword">New Password</label>
                                <input id="newPassword" name="newPassword" type="password" minlength="6" autocomplete="new-password" required>
                                <small class="form-hint">Must contain at least 6 characters.</small>
                            </div>

                            <div class="form-row">
                                <label for="confirmPassword">Confirm New Password</label>
                                <input id="confirmPassword" name="confirmPassword" type="password" minlength="6" autocomplete="new-password" required>
                            </div>

                            <div class="form-actions" style="margin-top: 20px;">
                                <button type="submit" class="button secondary">Update Password</button>
                            </div>
                        </form>
                    </section>
                </div>
            </div>
        </main>
    </div>
</body>

</html>


    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Shoply Admin | Users</title>
        <link rel="stylesheet" href="/styles.css">
        <style>
            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background: var(--color-background);
                color: var(--color-text)
            }

            .main {
                max-width: 1100px;
                margin: 30px auto;
                padding: 0 20px
            }

            .panel {
                overflow: auto;
                background: var(--color-surface);
                border: 1px solid var(--color-border-subtle);
                border-radius: 8px
            }

            .table {
                width: 100%;
                border-collapse: collapse
            }

            .table th,
            .table td {
                padding: 15px;
                text-align: left;
                border-bottom: 1px solid var(--color-border)
            }

            .link {
                color: var(--color-link)
            }
        </style>
    </head>

    <body>
        <div class="layout">
            <%- include('partials/_sidebar') %>
        <main class="main">
            <h1>Users</h1>
            <section class="panel">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Joined</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user=> { %><tr>
                                <td>
                                    <%= user.name %>
                                </td>
                                <td>
                                    <%= user.email %>
                                </td>
                                <td>
                                    <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString() : '—' %>
                                </td>
                                <td>
                                    <%= user.status %>
                                </td>
                                <td>
                                    <% if (user.status === 'blocked') { %>
                                        <form action="/admin/users/<%= user._id %>/unblock" method="post">
                                            <button type="submit">Unblock</button>
                                        </form>
                                    <% } else { %>
                                        <form action="/admin/users/<%= user._id %>/block" method="post">
                                            <button type="submit">Block</button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                            <% }); %>
                        <% if (users.length === 0) { %>
                            <tr>
                                <td colspan="5">No users have registered yet.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </section>
        </main>
        </div>
    </body>

    </html>
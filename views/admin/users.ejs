<% const users = [{ id: 1, name: 'Alex Antony', email: 'alex@example.com', orders: 12, joined: 'Jan 2025', status: 'Active' }, { id: 2, name: 'Jamie Rivera', email: 'jamie@example.com', orders: 8, joined: 'Mar 2025', status: 'Active' }, { id: 3, name: 'Morgan Taylor', email: 'morgan@example.com', orders: 3, joined: 'Jun 2026', status: 'Suspended' }]; %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Shoply Admin | Users</title><style>body{margin:0;font-family:Arial,sans-serif;background:#f4f6f8;color:#20252b}.main{max-width:1100px;margin:30px auto;padding:0 20px}.panel{overflow:auto;background:#fff;border:1px solid #e5e7eb;border-radius:8px}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:15px;text-align:left;border-bottom:1px solid #e5e7eb}.link{color:#2563eb}</style></head><body><main class="main"><p><a href="/admin">Admin dashboard</a></p><h1>Users</h1><section class="panel"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Orders</th><th>Joined</th><th>Status</th><th></th></tr></thead><tbody><% users.forEach(user => { %><tr><td><%= user.name %></td><td><%= user.email %></td><td><%= user.orders %></td><td><%= user.joined %></td><td><%= user.status %></td><td><a class="link" href="/admin/users/<%= user.id %>">View</a></td></tr><% }); %></tbody></table></section></main></body></html>

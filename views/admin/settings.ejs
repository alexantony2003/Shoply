<% const settings = { storeName: 'Shoply', supportEmail: 'support@shoply.example', currency: 'USD', lowStockAlert: true, orderNotifications: true }; %>
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Shoply Admin | Settings</title>
	<link rel="stylesheet" href="/styles.css">
	<style>
		body { margin: 0; font-family: Arial, sans-serif; background: var(--color-background); color: var(--color-text); }
		.panel { max-width: 700px; margin: 30px auto; padding: 26px; background: var(--color-surface); border: 1px solid var(--color-border-subtle); border-radius: 8px; }
		label { display: block; margin: 16px 0 6px; font-weight: bold; }
		input, select { box-sizing: border-box; width: 100%; padding: 11px; border: 1px solid var(--color-border); border-radius: 6px; }
		.check { display: flex; gap: 10px; align-items: center; font-weight: normal; }
		.check input { width: auto; }
		button { margin-top: 22px; padding: 12px 18px; border: 0; border-radius: 6px; background: var(--color-primary); color: var(--color-text-on-solid); font-weight: bold; }
		a { color: var(--color-primary-text); }
	</style>
</head>
<body>
	<div class="layout">
		<%- include('partials/_sidebar') %>
		<main class="panel">
			<h1>Store settings</h1>
			<form action="/admin/settings" method="post">
				<label for="storeName">Store name</label>
				<input id="storeName" name="storeName" type="text" value="<%= settings.storeName %>" required>
				<label for="supportEmail">Support email</label>
				<input id="supportEmail" name="supportEmail" type="email" value="<%= settings.supportEmail %>" required>
				<label for="currency">Currency</label>
				<select id="currency" name="currency"><option selected><%= settings.currency %></option><option>EUR</option><option>GBP</option></select>
				<label class="check"><input name="lowStockAlert" type="checkbox" <%= settings.lowStockAlert ? 'checked' : '' %>> Send low-stock alerts</label>
				<label class="check"><input name="orderNotifications" type="checkbox" <%= settings.orderNotifications ? 'checked' : '' %>> Send new-order notifications</label>
				<button type="submit">Save settings</button>
			</form>
		</main>
	</div>
</body>
</html>

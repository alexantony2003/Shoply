<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shoply Admin | Categories</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
        .category-page {
            max-width: 1100px;
            margin: 0 auto;
            padding: 30px 20px;
        }

        .category-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            margin: 24px 0 20px;
        }

        .category-header h1 {
            margin: 0;
        }

        .category-button {
            display: inline-block;
            padding: 11px 16px;
            border-radius: 8px;
            background: var(--color-primary);
            color: var(--color-text-on-solid);
            font-weight: 800;
            text-decoration: none;
        }

        .category-table-wrap {
            overflow-x: auto;
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 14px;
            box-shadow: var(--shadow);
        }

        .category-table {
            width: 100%;
            min-width: 620px;
            border-collapse: collapse;
        }

        .category-table th,
        .category-table td {
            padding: 16px 18px;
            text-align: left;
            border-bottom: 1px solid var(--color-border);
        }

        .category-table th {
            background: var(--color-primary-soft);
            color: var(--color-primary-text);
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .category-table tr:last-child td {
            border-bottom: 0;
        }

        .category-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .category-actions a {
            font-weight: 700;
            text-decoration: none;
        }

        .category-actions .unlist {
            color: var(--color-accent-text);
        }

        [data-theme="dark"] .category-table-wrap {
            background: #151515;
            border-color: rgba(255, 255, 255, 0.12);
        }

        [data-theme="dark"] .category-table {
            background: #151515;
        }

        [data-theme="dark"] .category-table th {
            background: #1E293B;
            color: #FFFFFF;
            border-bottom: 2px solid rgba(255, 255, 255, 0.16);
        }

        [data-theme="dark"] .category-table td {
            background: transparent;
            color: #FFFFFF;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        [data-theme="dark"] .category-table td strong {
            color: #FFFFFF;
        }

        [data-theme="dark"] .category-actions a {
            color: #38BDF8;
        }

        [data-theme="dark"] .category-actions .unlist {
            color: #FB7185;
        }

        .category-name-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .category-icon {
            display: grid;
            width: 34px;
            height: 34px;
            flex: 0 0 34px;
            place-items: center;
            border-radius: 10px;
            color: var(--color-text-on-solid);
            background: linear-gradient(135deg, var(--color-danger), var(--color-primary));
        }

        .category-icon svg {
            width: 18px;
            height: 18px;
            stroke-width: 1.9;
        }

        .category-empty {
            padding: 30px 18px !important;
            color: var(--color-text-muted);
            text-align: center !important;
        }

        @media (max-width: 600px) {
            .category-page {
                padding: 22px 14px;
            }

            .category-header {
                align-items: stretch;
                flex-direction: column;
            }

            .category-button {
                text-align: center;
            }
        }
    </style>
</head>

<body>
<div class="layout">
    <%- include('partials/_sidebar') %>
    <main class="category-page">

    <div class="category-header">
        <h1>Categories</h1>
        <a class="category-button" href="/admin/categories/new">+ Add Category</a>
    </div>

    <div class="category-table-wrap">
    <table class="category-table">

    <thead>
        <tr>
            <th>#</th>
            <th>Category Name</th>
            <th>Stock Available</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        <% if (categories.length === 0) { %>

            <tr>
                <td colspan="4" class="category-empty">
                    No categories found
                </td>
            </tr>

        <% } else { %>

            <% categories.forEach((category, index) => { %>

                <tr>

                    <td class="category-actions">
                        <%= index + 1 %>
                    </td>

                    <td>
                        <span class="category-name-cell">
                            <span class="category-icon" aria-hidden="true"><%- category.iconSvg %></span>
                            <span><%= category.name %></span>
                        </span>
                    </td>

                    <td>
                        <strong>
                            <%= category.stockAvailable %>
                        </strong>
                    </td>

                    <td>

                        <% if (category.status) { %>

                            <a
                                href="/admin/categories/<%= category._id %>/edit"
                                class="edit">
                                Edit
                            </a>

                            <a
                                href="/admin/categories/<%= category._id %>/unlist"
                                class="unlist"
                                onclick="return confirm('Unlist this category?')">
                                Unlist
                            </a>

                        <% } else { %>

                            <span>Unlisted</span>

                            <a
                                href="/admin/categories/<%= category._id %>/list"
                                class="edit">
                                List
                            </a>

                        <% } %>

                    </td>

                </tr>

            <% }) %>

        <% } %>

    </tbody>
    </table>
    </div>
</main>
    </div>
</body>

</html>
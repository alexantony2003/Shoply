<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shoply Admin | <%= category ? 'Edit' : 'Add' %> Category</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
        .category-form-page {
            max-width: 680px;
            margin: 0 auto;
            padding: 30px 20px;
        }

        .category-form-card {
            margin-top: 24px;
            padding: 28px;
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 14px;
            box-shadow: var(--shadow);
        }

        .category-form-card h1 {
            margin-top: 0;
        }

        .category-form-card label {
            display: block;
            margin: 20px 0 7px;
            font-weight: 800;
        }

        .category-form-card input {
            width: 100%;
            padding: 12px;
            border: 1px solid var(--color-border);
            border-radius: 8px;
            font: inherit;
        }

        .category-form-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 14px;
            margin-top: 24px;
        }

        .category-form-actions button {
            padding: 12px 18px;
            cursor: pointer;
        }

        .category-form-actions a {
            font-weight: 700;
            text-decoration: none;
        }

        .category-icon-preview {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 12px;
            padding: 12px 14px;
            border: 1px dashed var(--color-border);
            border-radius: 12px;
            background: var(--color-surface);
        }

        .category-icon-preview__icon {
            display: grid;
            width: 42px;
            height: 42px;
            flex: 0 0 42px;
            place-items: center;
            border-radius: 12px;
            color: var(--color-text-on-solid);
            background: linear-gradient(135deg, var(--color-danger), var(--color-primary));
        }

        .category-icon-preview__icon svg {
            width: 22px;
            height: 22px;
            stroke-width: 1.9;
        }

        .category-icon-preview__text {
            color: var(--color-text-muted);
            font-size: 14px;
        }

        @media (max-width: 520px) {
            .category-form-page {
                padding: 22px 14px;
            }

            .category-form-card {
                padding: 20px;
            }

            .category-form-actions button,
            .category-form-actions a {
                width: 100%;
                text-align: center;
            }
        }
    </style>
</head>

<body>
<div class="layout">
    <%- include('partials/_sidebar') %>
<main class="category-form-page main">
    <p><a href="/admin/categories">Back to Categories</a></p>

    <section class="category-form-card">
        <h1><%= category && category._id ? "Edit Category" : "Add Category" %></h1>

        <% if (typeof error !== 'undefined' && error) { %>
            <div style="padding: 12px 14px; border-radius: 8px; margin-bottom: 18px; background: var(--color-danger-soft); border: 1px solid var(--color-danger); color: var(--color-danger-text); font-size: 14px;">
                <%= error %>
            </div>
        <% } %>

        <form
            action="<%= category && category._id
                ? '/admin/categories/' + category._id + '/edit'
                : '/admin/categories'
            %>"
            method="POST"
        >
            <label for="category-name">Category name</label>
            <input
                id="category-name"
                type="text"
                name="name"
                value="<%= category ? category.name : '' %>"
                placeholder="Example: Phone"
                autocomplete="off"
                required
            >

            <label for="category-icon">Category icon</label>
            <select id="category-icon" name="icon" data-category-icon-select>
                <option value="" <%= selectedIcon ? '' : 'selected' %>>Automatic (match the category name)</option>
                <% iconOptions.forEach((option) => { %>
                    <option value="<%= option.key %>" <%= selectedIcon === option.key ? 'selected' : '' %>>
                        <%= option.label %>
                    </option>
                <% }); %>
            </select>

            <div class="category-icon-preview">
                <span class="category-icon-preview__icon" data-category-icon-preview-icon></span>
                <span class="category-icon-preview__text" data-category-icon-preview-text></span>
            </div>

            <div class="category-form-actions">
                <button type="submit">
                    <%= category ? "Update Category" : "Add Category" %>
                </button>
                <a href="/admin/categories">Cancel</a>
            </div>
        </form>
    </section>
</main>
</div>

<script type="application/json" id="category-icon-svg-map"><%- JSON.stringify(iconOptions.reduce((map, option) => {
    map[option.key] = option.svg;
    return map;
}, {})) %></script>

<script>
    (function () {
        var select = document.querySelector('[data-category-icon-select]');
        var previewIcon = document.querySelector('[data-category-icon-preview-icon]');
        var previewText = document.querySelector('[data-category-icon-preview-text]');

        if (!select || !previewIcon || !previewText) {
            return;
        }

        var iconMap = {};
        var source = document.getElementById('category-icon-svg-map');

        try {
            iconMap = source ? JSON.parse(source.textContent) : {};
        } catch (error) {
            iconMap = {};
        }

        var labels = { '': 'Automatic icon, chosen from the category name.' };

        Array.prototype.forEach.call(select.options, function (option) {
            if (option.value) {
                labels[option.value] = option.textContent.trim() + ' icon selected.';
            }
        });

        function renderPreview() {
            previewIcon.innerHTML = iconMap[select.value] || '';
            previewText.textContent = labels[select.value] || '';
        }

        select.addEventListener('change', renderPreview);
        renderPreview();
    })();
</script>
</body>

</html>
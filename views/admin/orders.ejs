<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Shoply Admin | Orders</title><link rel="stylesheet" href="/styles.css"></head>
<body><div class="layout"><%- include('partials/_sidebar') %><main class="main" style="padding:30px">
  <h1>Order management</h1>
  <section class="panel" style="overflow:auto"><table style="width:100%;border-collapse:collapse"><thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Total</th><th>Payment</th><th>Status</th><th>Update</th></tr></thead><tbody>
  <% orders.forEach(order => { %><tr>
    <td><%= order.orderNumber %></td><td><%= order.user ? order.user.name : "Deleted user" %><br><%= order.user ? order.user.email : "" %></td>
    <td><%= new Date(order.createdAt).toLocaleString() %></td><td>₹<%= Number(order.total).toFixed(2) %></td><td><%= order.paymentMethod %></td><td><%= order.status %></td>
    <td><% if (!["Cancelled","Returned"].includes(order.status)) { %>
      <form action="/admin/orders/<%= order._id %>/status" method="post">
        <select name="status" aria-label="Order status">
          <% ["Pending","Processing","Shipped","Delivered","Cancelled","Return requested","Returned"].forEach(status => { %><option value="<%= status %>" <%= order.status === status ? "selected" : "" %>><%= status %></option><% }); %>
        </select><button type="submit">Save</button>
      </form>
    <% } else { %><%= order.status %><% } %></td>
  </tr><% }); %>
  </tbody></table><% if (!orders.length) { %><p>No orders yet.</p><% } %></section>
</main></div></body></html>

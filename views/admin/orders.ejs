<% const orders = [{ id: 'SHP-1048', customer: 'Alex Antony', date: 'September 18, 2026', total: 208.99, status: 'Delivered' }, { id: 'SHP-1047', customer: 'Jamie Rivera', date: 'September 17, 2026', total: 129.00, status: 'Processing' }, { id: 'SHP-1046', customer: 'Morgan Taylor', date: 'September 16, 2026', total: 64.50, status: 'Shipped' }, { id: 'SHP-1045', customer: 'Taylor Brown', date: 'September 15, 2026', total: 42.00, status: 'Cancelled' }]; %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Shoply Admin | Orders</title><style>body{margin:0;font-family:Arial,sans-serif;background:#f4f6f8;color:#20252b}.main{max-width:1100px;margin:30px auto;padding:0 20px}.panel{overflow:auto;background:#fff;border:1px solid #e5e7eb;border-radius:8px}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:15px;text-align:left;border-bottom:1px solid #e5e7eb}.link{color:#2563eb}.status{font-weight:bold}</style></head><body><main class="main"><p><a href="/admin">Admin dashboard</a></p><h1>Order management</h1><section class="panel"><table class="table"><thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody><% orders.forEach(order => { %><tr><td><%= order.id %></td><td><%= order.customer %></td><td><%= order.date %></td><td>$<%= order.total.toFixed(2) %></td><td class="status"><%= order.status %></td><td><a class="link" href="/admin/orders/<%= order.id %>">Manage</a></td></tr><% }); %></tbody></table></section></main></body></html>

<% const metrics = [{ label: 'Revenue', value: '$24,680', change: '+12.4%' }, { label: 'Orders', value: '348', change: '+8.2%' }, { label: 'Customers', value: '1,204', change: '+5.7%' }, { label: 'Products', value: '86', change: '+3 new' }]; const recentOrders = [{ id: 'SHP-1048', customer: 'Alex Antony', total: '$208.99', status: 'Delivered' }, { id: 'SHP-1047', customer: 'Jamie Rivera', total: '$129.00', status: 'Processing' }, { id: 'SHP-1046', customer: 'Morgan Taylor', total: '$64.50', status: 'Shipped' }]; %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Shoply Admin | Dashboard</title><style>body{margin:0;font-family:Arial,sans-serif;background:#f4f6f8;color:#20252b}.layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh}.sidebar{padding:24px;background:#172033;color:#fff}.brand{font-size:23px;font-weight:bold;color:#93c5fd}.sidebar a{display:block;padding:13px 0;color:#d0d5dd;text-decoration:none}.main{padding:30px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.metric,.panel{padding:20px;background:#fff;border:1px solid #e5e7eb;border-radius:8px}.metric strong{display:block;font-size:25px;margin:8px 0}.change{color:#067647}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:13px;text-align:left;border-bottom:1px solid #e5e7eb}@media(max-width:800px){.layout{grid-template-columns:1fr}.sidebar{display:flex;gap:18px;flex-wrap:wrap}.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:480px){.metrics{grid-template-columns:1fr}}</style></head><body><div class="layout"><aside class="sidebar"><div class="brand">Shoply Admin</div><a href="/admin">Dashboard</a><a href="/admin/products">Products</a><a href="/admin/orders">Orders</a><a href="/admin/users">Users</a><a href="/admin/settings">Settings</a><a href="/">View store</a></aside><main class="main"><h1>Dashboard</h1><section class="metrics"><% metrics.forEach(metric => { %><article class="metric"><span><%= metric.label %></span><strong><%= metric.value %></strong><span class="change"><%= metric.change %></span></article><% }); %></section><section class="panel"><h2>Recent orders</h2><table class="table"><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th></tr></thead><tbody><% recentOrders.forEach(order => { %><tr><td><%= order.id %></td><td><%= order.customer %></td><td><%= order.total %></td><td><%= order.status %></td></tr><% }); %></tbody></table></section></main></div></body></html>

<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Shoply Admin | Sales report</title><link rel="stylesheet" href="/styles.css"></head>
<body><div class="layout"><%- include('partials/_sidebar') %><main class="main" style="padding:30px"><h1>Sales report</h1>
  <section class="panel" style="padding:22px"><form action="/admin/sales-report" method="get" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end"><label>Period <select name="range"><% [['day','Today'],['week','Last 7 days'],['month','This month'],['year','This year']].forEach(item => { %><option value="<%= item[0] %>" <%= query.range === item[0] ? 'selected' : '' %>><%= item[1] %></option><% }) %></select></label><label>From <input name="from" type="date" value="<%= query.from || '' %>"></label><label>To <input name="to" type="date" value="<%= query.to || '' %>"></label><button class="button" type="submit">Generate report</button><a class="button secondary" href="/admin/sales-report/export.csv?<%= new URLSearchParams(query).toString() %>">Download Excel CSV</a></form></section>
  <section class="metrics" style="margin:20px 0"><article class="metric"><span>Overall sales count</span><strong><%= report.summary.salesCount %></strong></article><article class="metric"><span>Overall order amount</span><strong>₹<%= Number(report.summary.orderAmount).toFixed(2) %></strong></article><article class="metric"><span>Overall discount</span><strong>₹<%= Number(report.summary.discount).toFixed(2) %></strong></article></section>
  <section class="panel" style="padding:22px;overflow:auto"><p><%= report.start.toLocaleDateString() %> – <%= report.end.toLocaleDateString() %></p><table class="table"><thead><tr><th>Order</th><th>Date</th><th>Customer</th><th>Payment</th><th>Discount</th><th>Total</th></tr></thead><tbody><% report.orders.forEach(order => { %><tr><td><%= order.orderNumber %></td><td><%= new Date(order.createdAt).toLocaleDateString() %></td><td><%= order.user ? order.user.name : 'Deleted user' %></td><td><%= order.paymentMethod %></td><td>₹<%= Number(order.discountAmount || 0).toFixed(2) %></td><td>₹<%= Number(order.total).toFixed(2) %></td></tr><% }) %></tbody></table></section>
</main></div></body></html>

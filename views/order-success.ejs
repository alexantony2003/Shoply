<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Shoply | Order placed</title><link rel="stylesheet" href="/styles.css"></head>
<body><main class="panel" style="max-width:620px;margin:8vh auto;padding:34px;text-align:center">
  <h1><%= order.paymentStatus === 'Paid' ? 'Payment successful' : 'Order placed' %></h1><p>Your order <strong><%= order.orderNumber %></strong> is <% if (order.paymentStatus === 'Paid') { %>paid in full.<% } else if (order.paymentMethod === 'Razorpay') { %>awaiting online payment.<% } else if (order.paymentMethod === 'Wallet') { %>paid with your wallet.<% } else { %>confirmed. Pay ₹<%= Number(order.total).toFixed(2) %> by cash on delivery.<% } %></p>
  <p>Status: <%= order.status %></p><a class="button" href="/orders/<%= order._id %>">View order</a>
  <a href="/products">Continue shopping</a>
</main></body></html>

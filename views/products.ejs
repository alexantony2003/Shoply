<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Shoply | Products</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            color: var(--color-text);
            background: var(--color-background);
        }

        header {
            padding: 18px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--color-surface);
            border-bottom: 1px solid var(--color-border-subtle);
        }

        nav {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        nav a {
            color: var(--color-text);
            text-decoration: none;
        }

        .brand {
            color: var(--color-primary-text);
            font-size: 24px;
            font-weight: bold;
            text-decoration: none;
        }

        .content {
            max-width: 1100px;
            margin: 0 auto;
            padding: 34px 6%;
        }

        .search {
            display: flex;
            gap: 10px;
            margin: 20px 0 28px;
        }

        .search input {
            flex: 1;
            padding: 12px;
            border: 1px solid var(--color-border);
            border-radius: 6px;
            font-size: 16px;
        }

        .button {
            display: inline-block;
            padding: 11px 16px;
            border: 0;
            background: var(--color-primary);
            color: var(--color-text-on-solid);
            border-radius: 6px;
            text-decoration: none;
            cursor: pointer;
        }

        .button:hover {
            background: var(--color-primary-hover);
        }

        .products {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        .product {
            padding: 20px;
            background: var(--color-surface);
            border: 1px solid var(--color-border-subtle);
            border-radius: 8px;
            transition: box-shadow 0.2s ease;
        }

        .product.unavailable-product {
            background: var(--color-surface-soft);
            border-color: var(--color-border);
            filter: grayscale(1);
            opacity: .78;
        }

        .unavailable-label {
            display: inline-block;
            margin: 8px 0;
            padding: 6px 10px;
            border-radius: 6px;
            background: var(--color-border-strong);
            color: var(--color-text-on-solid);
            font-size: 13px;
            font-weight: 700;
        }

        .product:hover {
            box-shadow: var(--shadow);
        }

        .product-image-frame {
            position: relative;
            display: block;
            overflow: hidden;
            border-radius: 8px;
            background: var(--color-surface-soft);
            perspective: 700px;
            touch-action: pan-y;
        }

        /* NEW PRODUCT BADGE */
        .newly-added-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 3;
            padding: 6px 11px;
            border-radius: 999px;
            color: var(--color-accent-contrast);
            background: var(--color-accent);
            box-shadow: var(--shadow-sm);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.04em;
            line-height: 1.3;
            pointer-events: none;
        }

        .image {
            width: 100%;
            aspect-ratio: 1 / 1;
            max-height: 230px;
            object-fit: cover;
            display: block;
            background: var(--color-surface-soft);
            border-radius: 8px;
            color: var(--color-text-muted);
        }

        [data-parallax-image] {
            transition: transform 0.22s ease-out;
        }

        .product-image-frame [data-parallax-image] {
            transform: translate3d(
                var(--parallax-x, 0px),
                var(--parallax-y, 0px),
                0
            );
        }

        .product-image-frame:hover [data-parallax-image] {
            transform: translate3d(
                var(--parallax-x, 0px),
                var(--parallax-y, 0px),
                0
            ) scale(1.08);
        }

        .price {
            display: flex;
            align-items: baseline;
            flex-wrap: wrap;
            gap: 7px;
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .original-price {
            color: var(--color-text-muted);
            text-decoration: line-through;
            font-size: 15px;
        }

        .discount {
            display: inline-block;
            color: var(--color-success-text);
            background: var(--color-success-soft);
            padding: 4px 8px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 800;
        }

        .rating {
            color: var(--color-accent-text);
        }

        .availability {
            font-size: 14px;
            font-weight: 600;
        }

        .availability.sold-out {
            color: var(--color-danger-text);
        }

        .breadcrumbs {
            margin-bottom: 18px;
            color: var(--color-text-muted);
            font-size: 14px;
        }

        .breadcrumbs a {
            color: var(--color-primary-text);
            text-decoration: none;
        }

        .filters {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin: 20px 0 28px;
        }

        .filters input,
        .filters select {
            min-width: 150px;
            padding: 12px;
            border: 1px solid var(--color-border);
            border-radius: 6px;
            font: inherit;
        }

        .filters input {
            flex: 1;
        }

        .product-link {
            color: inherit;
            text-decoration: none;
        }

        .product-link:hover h2 {
            color: var(--color-primary-text);
        }

        .empty {
            padding: 24px;
            background: var(--color-surface);
            border: 1px solid var(--color-border-subtle);
            border-radius: 8px;
        }

        @media (max-width: 560px) {
            header {
                padding: 16px 5%;
                flex-wrap: wrap;
                gap: 15px;
            }

            nav {
                gap: 12px;
                flex-wrap: wrap;
            }

            .filters {
                flex-direction: column;
            }

            .filters input,
            .filters select {
                width: 100%;
                box-sizing: border-box;
            }

            .content {
                padding: 25px 5%;
            }
        }
    </style>
</head>

<body>

    <header class="site-header glass-card">
        <a class="brand" href="/">Shoply</a>

        <nav class="glass-card">
            <a href="/">Home</a>
            <a href="/cart">Cart</a>
            <a href="/wishlist">Wishlist</a>
            <a href="/profile">Profile</a>
        </nav>
    </header>

    <%- include('partials/category-nav') %>

    <main class="content">

        <nav class="breadcrumbs glass-card" aria-label="Breadcrumb">
            <a href="/">Home</a> /
            <% if (selectedCategoryName) { %>
                <a href="/products">Products</a> /
                <span aria-current="page"><%= selectedCategoryName %></span>
            <% } else { %>
                <span aria-current="page">Products</span>
            <% } %>
        </nav>

        <h1><%= selectedCategoryName ? selectedCategoryName : 'Products' %></h1>

        <% if (categoryNotFound) { %>
            <p class="empty" role="alert">
                That category does not exist or is no longer available.
                <a href="/products">Browse all products</a>
            </p>
        <% } %>

        <!-- SEARCH, CATEGORY FILTER AND SORT -->
        <form class="filters" action="/products" method="get">

            <input
                name="search"
                type="search"
                value="<%= search || '' %>"
                placeholder="Search products by name, category, or description"
                aria-label="Search products"
            >

            <select name="category" aria-label="Filter by category">

                <option value="">All categories</option>

                <% categories.forEach(category => { %>

                    <option
                        value="<%= category._id %>"
                        <%= selectedCategory === String(category._id) ? 'selected' : '' %>
                    >
                        <%= category.name %>
                    </option>

                <% }); %>

            </select>

            <select name="sort" aria-label="Sort products">

                <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>Popularity</option>
                <option value="newest"
                    <%= sort === 'newest' ? 'selected' : '' %>>
                    New arrivals
                </option>

                <option value="price-low"
                    <%= sort === 'price-low' ? 'selected' : '' %>>
                    Price: low to high
                </option>

                <option value="price-high"
                    <%= sort === 'price-high' ? 'selected' : '' %>>
                    Price: high to low
                </option>

                <option value="rating"
                    <%= sort === 'rating' ? 'selected' : '' %>>
                    Average ratings
                </option>

                <option value="featured" <%= sort === 'featured' ? 'selected' : '' %>>Featured</option>
                
            </select>

            <select name="availability" aria-label="Filter by stock status">
                <option value="all" <%= availability === 'all' ? 'selected' : '' %>>All stock statuses</option>
                <option value="in-stock" <%= availability === 'in-stock' ? 'selected' : '' %>>In stock</option>
                <option value="out-of-stock" <%= availability === 'out-of-stock' ? 'selected' : '' %>>Out of stock</option>
            </select>

            <button class="button" type="submit">Search</button>

        </form>

        <!-- PRODUCT LIST -->
        <% if (products.length === 0) { %>

            <p class="empty">
                <% if (selectedCategoryName) { %>
                    No products in <%= selectedCategoryName %> yet.
                    <a href="/products">Browse all products</a>
                <% } else { %>
                    No products found.
                <% } %>
            </p>

        <% } else { %>

            <div class="products">

                <% products.forEach(product => { %>
                        <%
                            const isCategoryUnlisted = !product.category || product.category.status === false;
                            const isUnavailable = product.status !== 'active' || isCategoryUnlisted;
                        %>
                    <article class="product <%= isUnavailable ? 'unavailable-product' : '' %>">

                        <%
                            const productImages =
                                product.variants &&
                                product.variants.length &&
                                product.variants[0].images &&
                                product.variants[0].images.length
                                    ? product.variants[0].images
                                    : (
                                        product.images && product.images.length
                                            ? product.images
                                            : (product.image ? [product.image] : [])
                                    );

                            const productImage = productImages[0];

                            // Respect the admin-controlled tag when it is explicitly enabled,
                            // while keeping the short 48-hour fallback for newer products.
                            const productCreatedAt = product.createdAt
                                ? new Date(product.createdAt).getTime()
                                : NaN;

                            const productAge = Date.now() - productCreatedAt;

                            const isNewProduct =
                                Boolean(product.showNewTag) ||
                                (
                                    Number.isFinite(productCreatedAt) &&
                                    productAge >= 0 &&
                                    productAge < 2 * 24 * 60 * 60 * 1000
                                );
                            const cardVariants = Array.from(product.variants || []);
                            const sellingPrice = Number(
                                cardVariants[0] && cardVariants[0].options && cardVariants[0].options[0]
                                    ? cardVariants[0].options[0].price
                                    : product.price
                            ) || 0;
                            const configuredDiscount = Number(product.discountPercentage) || 0;
                            const displayOriginalPrice = Number(product.originalPrice) > sellingPrice
                                ? Number(product.originalPrice)
                                : (configuredDiscount > 0 && configuredDiscount < 100
                                    ? sellingPrice / (1 - configuredDiscount / 100)
                                    : null);
                            const displayDiscountPercentage = displayOriginalPrice
                                ? Math.round((displayOriginalPrice - sellingPrice) / displayOriginalPrice * 100)
                                : 0;
                        %>

                        <!-- PRODUCT IMAGE -->
                        <% if (productImage) { %>

                            <a
                                class="product-link product-image-frame"
                                data-parallax-area
                                data-swipe-gallery
                                data-image-list="<%= JSON.stringify(productImages) %>"
                                href="/products/<%= product._id %>"
                            >

                                <!-- NEW BADGE: SHOWN FOR ADMIN-SELECTED OR RECENTLY ADDED PRODUCTS -->
                                <% if (isUnavailable) { %>
                                    <span class="unavailable-badge">Unavailable</span>
                                <% } else if (isNewProduct && product.status === 'active') { %>
                                    <span class="newly-added-badge">NEW</span>
                                <% } %>

                                <img
                                    class="image"
                                    data-parallax-image
                                    data-gallery-image
                                    src="<%= productImage %>"
                                    alt="<%= product.name %>"
                                    loading="lazy"
                                >

                            </a>

                        <% } else { %>

                            <a
                                class="product-link product-image-frame"
                                href="/products/<%= product._id %>"
                            >
                                <div class="image">
                                    Product image
                                </div>
                            </a>

                        <% } %>
                        <% if (isUnavailable) { %>
                            <p class="unavailable-label" role="status">Unavailable</p>
                        <% } %>

                        <!-- PRODUCT NAME -->
                        <a
                            class="product-link"
                            href="/products/<%= product._id %>"
                        >
                            <h2><%= product.name %></h2>
                        </a>

                        <!-- PRODUCT RATING -->
                        <p class="rating">
                            ★ <%= Number(product.rating || 0).toFixed(1) %> / 5
                            (<%= product.reviews ? product.reviews.length : 0 %> reviews)
                        </p>

                        <!-- PRODUCT PRICE AND DISCOUNT -->
                        <p class="price">
                            <% if (displayOriginalPrice && displayDiscountPercentage > 0) { %>
                                <span class="discount">&darr;<%= displayDiscountPercentage %>%</span>
                                <span class="original-price">₹<%= displayOriginalPrice.toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) %></span>
                            <% } %>
                            <span>₹<%= sellingPrice.toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) %></span>
                        </p>

                        <!-- STOCK AVAILABILITY -->
                        <% if (product.status !== 'active') { %>

                            <p class="availability sold-out" role="status">Product is not available</p>

                        <% } else if (product.stock > 0) { %>

                            <p class="availability">
                                <%= product.stock <= 5
                                    ? `Only ${product.stock} left in stock`
                                    : `${product.stock} in stock` %>
                            </p>

                        <% } else { %>

                            <p class="availability sold-out" role="status">
                                Sold out · Out of stock
                            </p>

                        <% } %>

                        <!-- VIEW DETAILS -->
                        <a
                            class="button"
                            href="/products/<%= product._id %>"
                        >
                            View details
                        </a>
                        <form action="/wishlist/<%= product._id %>" method="post"><button class="secondary" type="submit">Save to wishlist</button></form>

                    </article>

                <% }); %>

            </div>

        <% } %>

    </main>

</body>
</html>

# Copy to .env for local development. Keep real credentials out of source control.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/shoply
# Production requires a unique random SESSION_SECRET of at least 32 UTF-8 bytes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Configure these before enabling the Razorpay checkout option.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Optional first-time admin bootstrap. Set both values to create a new admin account.
# Use a unique password with at least 16 characters (maximum 72 UTF-8 bytes).
# Existing admin passwords are never reset at startup; promote existing users explicitly.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

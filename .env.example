# Copy to .env for local development. Keep real credentials out of source control.
MONGODB_URI=mongodb://127.0.0.1:27017/shoply
SESSION_SECRET=replace-with-a-long-random-session-secret

# Configure these before enabling the Razorpay checkout option.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# The configured password is synchronized to this account at each server startup.
# Use a unique password with at least 12 characters (maximum 72 UTF-8 bytes).
ADMIN_NAME=Store Admin
ADMIN_EMAIL=alexantony418324@gmail.com
ADMIN_PASSWORD=123

